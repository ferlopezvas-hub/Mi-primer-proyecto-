# Copia este archivo a .env y rellena tus valores. .env NUNCA se sube a git.

# Claves del exchange (solo necesarias en modo live)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Sobrescribe el modo de config/settings.yaml: paper | live
TRADING_MODE=paper

# Nivel de logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
