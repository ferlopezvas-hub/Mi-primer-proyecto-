# ======= SPORT AI PREDICTOR - variables de entorno (NUNCA subas el .env real a git) =======
ENVIRONMENT=production
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
PUBLIC_WEB_URL=https://app.tu-dominio.com
CORS_ORIGINS=https://app.tu-dominio.com
API_DOMAIN=api.tu-dominio.com

# Base de datos (docker-compose la construye con estos valores)
POSTGRES_USER=sportai
POSTGRES_PASSWORD=
POSTGRES_DB=sportai
# Si usas una base de datos gestionada (Neon, Supabase, RDS...), define directamente:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/sportai?sslmode=require
# REDIS_URL=rediss://default:clave@host:6379/0

# Proveedores de datos (vacío = desactivado). Revisa docs/DATA_PROVIDERS.md
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_QUOTA=100
API_FOOTBALL_LEAGUES=140:2026,39:2026,2:2026
API_BASKETBALL_KEY=
API_BASKETBALL_DAILY_QUOTA=100
API_BASKETBALL_LEAGUES=12:2026-2027,120:2026-2027
API_TENNIS_KEY=
API_TENNIS_DAILY_QUOTA=1000
FOOTBALL_DATA_ORG_KEY=

# Frecuencias (segundos). Ajusta LIVE_POLL_SECONDS a tu cuota: 60 s = hasta 1.440 llamadas/día en directo.
LIVE_POLL_SECONDS=60
FIXTURES_SYNC_SECONDS=21600
RESULTS_SYNC_SECONDS=900
PREDICTIONS_SECONDS=3600

# Web Push. Genera con: python -m app.cli vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# Correo (recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tu-dominio.com

# Observabilidad
SENTRY_DSN=
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
BACKUP_KEEP_DAYS=14
